[Unit]
Description=Pepper Watch Wi-Fi: a saved network in range, or the access point
Documentation=man:nmcli(1)
# Ordering only. A Wants= here would start NetworkManager at boot even on an
# image that deliberately runs another network stack, and the AP is skipped
# there anyway.
After=NetworkManager.service
Before=pepperwatch-web.service
# install.sh writes this flag on boards with no Wi-Fi radio, or where
# NetworkManager is not in charge; the unit is then skipped, not failed.
ConditionPathExists=!/etc/pepperwatch/ap.disabled
PartOf=pepperwatch.target

[Service]
# oneshot + RemainAfterExit: deciding and bringing the network up is a single
# idempotent action, not a daemon. NetworkManager owns the interface after.
# `systemctl restart pepperwatch-ap` re-decides (saved network or hotspot).
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/pepperwatch/deploy/network/setup-ap.sh
# "-": on a saved network the hotspot was never up, so there is nothing to stop.
ExecStop=-/usr/bin/nmcli connection down pepperwatch-ap
# A scan, up to 30 s joining a saved network, then the hotspot if that failed.
TimeoutStartSec=120

[Install]
WantedBy=pepperwatch.target
