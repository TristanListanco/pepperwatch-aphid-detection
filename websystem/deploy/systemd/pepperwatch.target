[Unit]
Description=Pepper Watch edge node
# One unit to enable. §3.4.5 requires that the moment the solar subsystem
# supplies power, the access point, camera, broker, inference loop and web
# server all initialise together with no keyboard intervention:
#
#   sudo systemctl enable pepperwatch.target
#
# The access point is wanted, not required: boards without a Wi-Fi radio
# (Banana Pi M5, some Orange Pi 5 variants) serve the dashboard over Ethernet
# instead, and install.sh leaves the AP disabled there.
Requires=pepperwatch-worker.service pepperwatch-web.service
Wants=pepperwatch-ap.service
After=pepperwatch-ap.service

[Install]
WantedBy=multi-user.target
